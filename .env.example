# deionizer configuration — copy to `.env` and fill in.
#
# The `chore` runner loads `.env` and passes each value to the binary as a
# command-line flag. The binary itself NEVER reads the environment: this file is
# the single, explicit source of deployment config, and the path from here to the
# binary is one hop (.env -> chore -> --flags -> binary), with nothing loaded by
# magic anywhere in between.
#
# `.env` is gitignored; this `.env.example` is the committed template.

# Base URL the ionCube loader bundles are downloaded from at image-build time.
# The tool does not hardcode or redistribute the vendor's endpoint — get the
# current URL from their downloads page. Required to build any runtime image.
#   -> --loader-base-url
DEIONIZER_LOADER_BASE_URL=

# Deep-decode extension build context (the decode.c / config.m4 tree). This is
# NOT shipped with the tool; supply your own. Blank = the default tmp/deionizer-ext.
# Interface recovery (--skeleton) needs none of this.
#   -> --ext-dir
DEIONIZER_EXT_DIR=

# Extra app bootstrap guard constants to define before a guarded module loads,
# comma-separated NAME or NAME=VALUE (e.g. MYAPP_KERNEL,APP_ENV=production).
#   -> --guard-consts
DEIONIZER_GUARD_CONSTS=

# Overlay YAML for the runtime matrix (optional; blank = built-in matrix only).
#   -> --runtimes
DEIONIZER_RUNTIMES=

# Private dump corpus for the render-all / coverage TESTS only (consumed by
# `go test`, not by the binary). Blank = those tests skip. Default: tmp/corpus.
DEIONIZER_CORPUS_DIR=
