# Deep-decode runtime for PHP 5.6 — generated and built by internal/docker.
# Compiles the decode extension (decode56.c) on the amd64 php:5.6 base image
# (deionizer:php5.6), loaded as a plain extension= module. Build --platform linux/amd64.
# The build context must supply decode56.c + config56.m4 (see DEIONIZER_EXT_DIR).
FROM deionizer:php5.6
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends $PHPIZE_DEPS binutils file; \
    rm -rf /var/lib/apt/lists/*
COPY decode56.c config56.m4 /src/decode56/
RUN set -eux; \
    cd /src/decode56; \
    mv config56.m4 config.m4; \
    phpize; \
    ./configure --enable-decode56; \
    make -j2; \
    make install; \
    echo "extension=decode56.so" > "$PHP_INI_DIR/conf.d/20-decode56.ini"; \
    php -m | grep -iE "decode56|ionCube" || true
ENTRYPOINT ["php"]
